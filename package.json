{
  "name": "foxwright-workspace",
  "private": true,
  "version": "0.7.1",
  "description": "Foxwright: let AI agents (Claude, via MCP) drive your real Firefox.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm --prefix host run build",
    "build:extension": "node scripts/build.mjs",
    "lint": "node scripts/build.mjs && web-ext lint --source-dir dist/store && web-ext lint --source-dir dist/full",
    "package": "node scripts/build.mjs --zip",
    "test": "node test/e2e.mjs",
    "test:trusted": "FOXWRIGHT_E2E_TRUSTED=1 node test/e2e.mjs",
    "test:permissions": "node test/e2e-permissions.mjs",
    "test:store": "node test/e2e-store.mjs",
    "test:storebuild": "node test/e2e-storebuild.mjs && FOXWRIGHT_E2E_TRUSTED=1 node test/e2e-storebuild.mjs",
    "test:idle": "node test/e2e-idle.mjs",
    "test:safety": "node test/e2e-safety.mjs",
    "test:resilience": "node test/e2e-resilience.mjs",
    "test:multi": "node test/e2e-multi.mjs",
    "test:gaps": "node test/run-suites.mjs gaps",
    "test:smoke": "node test/e2e-smoke.mjs",
    "test:all": "node test/e2e.mjs && FOXWRIGHT_E2E_TRUSTED=1 node test/e2e.mjs && node test/e2e-safety.mjs && node test/e2e-permissions.mjs && node test/e2e-store.mjs && node test/e2e-resilience.mjs && node test/e2e-storebuild.mjs",
    "bench": "node test/bench-actions.mjs",
    "screenshots": "node scripts/amo-screenshots.mjs",
    "version:check": "node scripts/version.mjs check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "0.28.2",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-ext": "10.8.0"
  }
}
