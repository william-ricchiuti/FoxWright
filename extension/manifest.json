{
  "manifest_version": 3,
  "name": "Zenko",
  "version": "0.6.1",
  "description": "Lets an AI agent you run (such as Claude, over MCP) read and operate Firefox tabs, with per-site permission, its own tab group, and a Stop button.",
  "homepage_url": "https://github.com/william-ricchiuti/Zenko",
  "icons": {
    "48": "icons/zenko.svg",
    "96": "icons/zenko.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Zenko",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/zenko.svg"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kitsune@william-ricchiuti.com",
      "strict_min_version": "152.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity",
          "browsingActivity"
        ]
      }
    }
  },
  "commands": {
    "pause-agent": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Pause the AI agent (stop Zenko)"
    }
  }
}
